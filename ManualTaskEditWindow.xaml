<Window x:Class="Supertech.AutoUploadVideo.ManualTaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="人工补填节目"
        Width="460"
        Height="360"
        MinWidth="420"
        MinHeight="330"
        WindowStartupLocation="CenterOwner"
        Background="#eef2f7">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0 0 0 16">
            <TextBlock Text="人工补填节目识别信息" FontSize="20" FontWeight="SemiBold" Foreground="#0f172a" />
            <TextBlock x:Name="FileNameText" TextWrapping="Wrap" Foreground="#64748b" Margin="0 6 0 0" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="节目号" FontWeight="SemiBold" Margin="0 0 0 6" />
                    <TextBox x:Name="ProgramNumberBox" Height="34" Padding="10 6" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0 14 0 0">
                    <TextBlock Text="节目名" FontWeight="SemiBold" Margin="0 0 0 6" />
                    <TextBox x:Name="ProgramNameBox" Height="34" Padding="10 6" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0 14 0 0">
                    <TextBlock Text="录制时间" FontWeight="SemiBold" Margin="0 0 0 6" />
                    <TextBox x:Name="RecordedAtBox" Height="34" Padding="10 6" />
                    <TextBlock Text="格式示例：2026-05-04-18-12-48 或 2026-05-04 18:12:48"
                               Foreground="#64748b" FontSize="12" Margin="0 6 0 0" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 16 0 0">
            <Button Content="取消" Width="86" Height="34" Margin="0 0 10 0" Click="Cancel_Click" />
            <Button Content="保存并上传" Width="116" Height="34" Background="#0f766e" Foreground="White" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
