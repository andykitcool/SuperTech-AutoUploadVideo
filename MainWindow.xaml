<Window x:Class="Supertech.AutoUploadVideo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supertech Auto Upload Video"
        Height="780"
        Width="1180"
        MinHeight="700"
        MinWidth="1080"
        Background="#eef2f7"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo" />
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#172033" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748b" />
        <SolidColorBrush x:Key="LineBrush" Color="#dbe3ef" />
        <SolidColorBrush x:Key="PanelBrush" Color="#ffffff" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0f766e" />

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10 6" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Background" Value="#f8fafc" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8 4" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Background" Value="#f8fafc" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14 0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#e2e8f0" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#f1f5f9" />
            <Setter Property="Foreground" Value="#334155" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0 0 0 8" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0 0 0 8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#0f172a" CornerRadius="8" Padding="20 18" Margin="0 0 0 16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="OBS 自动上传工作台" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="监听录制目录，自动解析节目文件名，断点直传云存储并同步到 WEB 管理端。"
                               Foreground="#cbd5e1" Margin="0 6 0 0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#102f2b" BorderBrush="#2dd4bf" BorderThickness="1" CornerRadius="8" Padding="10 6" Margin="0 0 10 0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#22c55e" Margin="0 0 8 0" VerticalAlignment="Center" />
                            <TextBlock x:Name="AuthStatusText" Text="已登录" Foreground="#ccfbf1" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Content="重新登录" Style="{StaticResource QuietButton}" Width="92" Click="ReLogin_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="配置" Foreground="#0f172a" FontSize="18" FontWeight="SemiBold" Margin="0 0 0 18" />

                        <TextBlock Text="绑定活动" Style="{StaticResource SectionTitle}" />
                        <DockPanel LastChildFill="True">
                            <Button Content="刷新" Width="66" Margin="0 0 8 0" Style="{StaticResource QuietButton}" Click="RefreshActivities_Click" />
                            <ComboBox x:Name="ActivityCombo" DisplayMemberPath="Name" SelectionChanged="ActivityCombo_SelectionChanged" />
                        </DockPanel>
                        <TextBlock Text="新检测到的视频会绑定到当前活动下的节目。"
                                   Style="{StaticResource HintText}" Margin="0 8 0 20" />

                        <TextBlock Text="监控目录" Style="{StaticResource SectionTitle}" />
                        <DockPanel LastChildFill="True">
                            <Button Content="选择" Width="66" Margin="0 0 8 0" Style="{StaticResource QuietButton}" Click="BrowseFolder_Click" />
                            <TextBox x:Name="WatchFolderBox" LostFocus="SettingsInput_LostFocus" />
                        </DockPanel>
                        <TextBlock Text="请选择 OBS 保存 .mp4 视频的目录。"
                                   Style="{StaticResource HintText}" Margin="0 8 0 20" />

                        <TextBlock Text="上传模式" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="ParseFileNameBeforeUploadBox"
                                  Content="解析文件名后上传"
                                  Checked="SettingsCheckbox_Changed"
                                  Unchecked="SettingsCheckbox_Changed" />
                        <TextBlock Text="勾选时按文件名规则解析，解析失败进入待处理；不勾选时直接用编号自动入队，并从视频元数据读取录制时间。"
                                   Style="{StaticResource HintText}" Margin="0 0 0 20" />

                        <TextBlock Text="文件名规则" Style="{StaticResource SectionTitle}" />
                        <TextBox x:Name="PatternBox" LostFocus="SettingsInput_LostFocus" />
                        <TextBlock Text="示例：{节目号}-{节目名}-{录制时间}"
                                   Style="{StaticResource HintText}" Margin="0 8 0 10" />
                        <Button Content="保存配置" Style="{StaticResource PrimaryButton}" Margin="0 0 0 20" Click="SaveConfiguration_Click" />

                        <TextBlock Text="解析测试" Style="{StaticResource SectionTitle}" />
                        <TextBox x:Name="RuleTestBox" Text="004-板胡声声-15:34:20.mp4" />
                        <Button Content="解析文件名" Margin="0 10 0 0" Style="{StaticResource QuietButton}" Click="TestRule_Click" />
                        <TextBlock x:Name="RuleResultText"
                                   Foreground="#0f766e"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   LineHeight="19"
                                   Margin="0 8 0 0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="18" Margin="0 0 0 16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42" Height="42" Background="#ecfeff" CornerRadius="8" Margin="0 0 12 0">
                                <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="#94a3b8"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="监听控制" Foreground="#0f172a" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock x:Name="StatusText" Text="停止" Foreground="#64748b" Margin="0 3 0 0" />
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="StartStopButton"
                                Grid.Column="1"
                                Content="启动监听"
                                Width="138"
                                Style="{StaticResource PrimaryButton}"
                                Click="StartStop_Click" />
                    </Grid>
                </Border>

                <TabControl Grid.Row="1">
                    <TabItem Header="上传队列">
                        <DataGrid ItemsSource="{Binding Tasks}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  RowHeight="38"
                                  Margin="0 12 0 0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="220" />
                                <DataGridTextColumn Header="节目号" Binding="{Binding ProgramNumber, StringFormat=D3}" Width="68" />
                                <DataGridTextColumn Header="节目名" Binding="{Binding ProgramName}" Width="140" />
                                <DataGridTextColumn Header="大小" Binding="{Binding DisplaySize}" Width="88" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="92" />
                                <DataGridTemplateColumn Header="进度" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="16" />
                                                <TextBlock Text="{Binding DisplayProgress}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*" />
                            <DataGridTemplateColumn Header="操作" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="补填" Margin="0 0 6 0" Padding="8 2" Click="EditTaskManually_Click" />
                                            <Button Content="上传" Margin="0 0 6 0" Padding="8 2" Click="UploadTask_Click" />
                                            <Button Content="暂停" Margin="0 0 6 0" Padding="8 2" Click="PauseTask_Click" />
                                            <Button Content="取消" Padding="8 2" Click="AbortTask_Click" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="已上传视频">
                        <Grid Margin="0 12 0 0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button Content="刷新列表" Width="96" HorizontalAlignment="Left" Style="{StaticResource QuietButton}" Click="RefreshVideos_Click" />
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding UploadedVideos}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      Margin="0 12 0 0"
                                      RowHeight="38">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="节目号" Binding="{Binding ProgramSequenceNumber}" Width="76" />
                                    <DataGridTextColumn Header="节目名称" Binding="{Binding ProgramName}" Width="160" />
                                    <DataGridTextColumn Header="文件名" Binding="{Binding Filename}" Width="240" />
                                    <DataGridTextColumn Header="存储" Binding="{Binding StorageProvider}" Width="80" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80" />
                                    <DataGridTextColumn Header="上传时间" Binding="{Binding CreatedAt}" Width="160" />
                                    <DataGridTemplateColumn Header="操作" Width="184">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="打开" Margin="0 0 6 0" Padding="8 2" Click="OpenVideo_Click" />
                                                    <Button Content="复制链接" Margin="0 0 6 0" Padding="8 2" Click="CopyVideoUrl_Click" />
                                                    <Button Content="删除" Padding="8 2" Click="DeleteVideo_Click" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="日志">
                        <TextBox x:Name="LogBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Background="#0f172a"
                                 Foreground="#dbeafe"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 Padding="12 10"
                                 Margin="0 12 0 0"
                                 MinHeight="480" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="状态颜色：灰=停止，绿=监听空闲，蓝=上传中，黄=暂停/待处理，红=错误。"
                   Foreground="#64748b"
                   Margin="2 10 0 0" />
    </Grid>
</Window>
