<Window x:Class="Supertech.AutoUploadVideo.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 Supertech Auto Upload Video"
        Width="720"
        Height="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#eef2f7">
    <Window.Resources>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0 0 0 7" />
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12 0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="#cbd5e1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#ffffff" />
        </Style>
        <Style x:Key="PasswordInputBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12 0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="#cbd5e1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#ffffff" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563eb" />
            <Setter Property="BorderBrush" Value="#2563eb" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="18 0" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Background" Value="#f8fafc" />
            <Setter Property="BorderBrush" Value="#cbd5e1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16 0" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Border CornerRadius="14" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="#64748b" BlurRadius="28" ShadowDepth="8" Opacity="0.18" />
            </Border.Effect>
            <Grid ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="286" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border CornerRadius="14 0 0 14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0f172a" Offset="0" />
                            <GradientStop Color="#123a5f" Offset="0.58" />
                            <GradientStop Color="#0b766d" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <Border Width="58" Height="58" CornerRadius="16" Background="#ffffff1f" HorizontalAlignment="Left" Margin="0 0 0 22">
                                <Grid>
                                    <Ellipse Width="18" Height="18" Fill="#22c55e" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse Width="34" Height="34" Stroke="#ffffff99" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <TextBlock Text="Supertech" Foreground="White" FontSize="27" FontWeight="SemiBold" />
                            <TextBlock Text="OBS 自动上传端" Foreground="#dbeafe" FontSize="18" Margin="0 4 0 0" />
                            <TextBlock Text="监听录制目录，断点直传云存储，并同步节目视频状态。"
                                       Foreground="#cbd5e1"
                                       TextWrapping="Wrap"
                                       LineHeight="22"
                                       Margin="0 22 0 0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <Border Background="#ffffff17" CornerRadius="8" Padding="12" Margin="0 0 0 10">
                                <TextBlock Text="状态颜色会在任务栏同步显示" Foreground="#e0f2fe" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="密码仅用于本次登录，不会保存到本机。" Foreground="#bae6fd" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="30 26 30 26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="登录控制台" FontSize="25" FontWeight="SemiBold" Foreground="#0f172a" />
                            <TextBlock Text="请输入管理端账号，登录后选择活动并开始监听。"
                                       Foreground="#64748b"
                                       Margin="0 6 0 0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="SettingsButton"
                                Content="⚙"
                                Width="38"
                                Height="38"
                                FontSize="18"
                                Background="#f8fafc"
                                BorderBrush="#cbd5e1"
                                ToolTip="设置服务器地址"
                                Click="Settings_Click" />
                    </Grid>

                    <Border x:Name="ServerSettingsPanel"
                            Grid.Row="1"
                            Visibility="Collapsed"
                            Background="#f8fafc"
                            BorderBrush="#dbe3ef"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0 18 0 0">
                        <StackPanel>
                            <TextBlock Text="服务器地址" Style="{StaticResource LabelText}" />
                            <TextBox x:Name="ServerUrlBox" Style="{StaticResource InputBox}" />
                            <TextBlock Text="示例：http://localhost:8000/api"
                                       Foreground="#64748b"
                                       FontSize="12"
                                       Margin="0 7 0 0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0 14 0 0">
                        <TextBlock Text="用户名" Style="{StaticResource LabelText}" />
                        <TextBox x:Name="UsernameBox" Style="{StaticResource InputBox}" Text="admin" />

                        <TextBlock Text="密码" Style="{StaticResource LabelText}" Margin="0 18 0 7" />
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource PasswordInputBox}"
                                     KeyDown="PasswordBox_KeyDown" />

                        <TextBlock x:Name="MessageText"
                                   Foreground="#dc2626"
                                   TextWrapping="Wrap"
                                   MinHeight="24"
                                   Margin="0 14 0 0" />
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0 18 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="按 Enter 可直接登录"
                                   Foreground="#64748b"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="取消"
                                Width="88"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0 0 10 0"
                                Click="Cancel_Click" />
                        <Button Grid.Column="2"
                                x:Name="LoginButton"
                                Content="登录"
                                Width="112"
                                Style="{StaticResource PrimaryButton}"
                                IsDefault="True"
                                Click="Login_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
